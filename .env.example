# NeoBot environment configuration.
#
# Copy this file to `.env` and fill in values, OR leave it mostly blank and use
# the first-run Setup Wizard in the dashboard (Phase 6). NeoBot boots fine with
# zero credentials — missing Supabase falls back to an in-memory store, and a
# missing Discord token simply disables the Discord subsystem.
#
# NEVER commit your real `.env` file. It is gitignored on purpose.

# --- Runtime ---
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Minecraft target server (one instance = one server) ---
MC_HOST=
MC_PORT=25565
# Leave blank to auto-detect the protocol version.
MC_VERSION=
MC_USERNAME=NeoBot

# --- Supabase (optional; blank = in-memory fallback) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Discord bot (optional; blank = subsystem disabled) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# --- Dashboard admin (optional; blank = created via setup wizard) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Safe-zone anchor + interaction radius (blocks) ---
SAFE_ZONE_X=
SAFE_ZONE_Y=
SAFE_ZONE_Z=
SAFE_ZONE_RADIUS=32

# --- Keep-alive self-ping fallback (default OFF; UptimeRobot is primary) ---
SELF_PING_ENABLED=false
SELF_PING_URL=
