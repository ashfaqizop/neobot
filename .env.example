# NeoBot environment configuration.
#
# Copy this file to `.env` and fill in values, OR leave it mostly blank and use
# the first-run Setup Wizard in the dashboard (Phase 6). NeoBot boots fine with
# zero credentials — missing Supabase falls back to an in-memory store, and a
# missing Discord token simply disables the Discord subsystem.
#
# NEVER commit your real `.env` file. It is gitignored on purpose.

# --- Runtime ---
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Minecraft target server (one instance = one server) ---
MC_HOST=
MC_PORT=25565
# Leave blank to auto-detect the protocol version.
MC_VERSION=
MC_USERNAME=NeoBot

# --- Supabase (optional; blank = in-memory fallback) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Discord bot (optional; blank = subsystem disabled) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# --- Dashboard admin (optional; blank = created via setup wizard) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Safe-zone anchor + interaction radius (blocks) ---
SAFE_ZONE_X=
SAFE_ZONE_Y=
SAFE_ZONE_Z=
SAFE_ZONE_RADIUS=32

# --- Behavior engine ---
# Real players within this radius pause ALL simulated activity (always-on safety).
PLAYER_PROXIMITY_RADIUS=16
# Chat is off by default (safest for real, populated servers).
CHAT_ENABLED=false
# Optional comma-separated pool of filler messages used when chat is enabled.
CHAT_MESSAGES=
# Block interaction / "mining": off | self-placed-only | radius-any (off = leave no trace).
BLOCK_INTERACTION_MODE=off
# Unrestricted roam/interaction for private/empty test servers you don't care about.
BLOCK_INTERACTION_BOUNDLESS=false
# Hazard self-preservation (lava/drowning/fall/hostile mobs). Recommended: true.
HAZARD_AVOIDANCE_ENABLED=true

# --- Keep-alive self-ping fallback (default OFF; UptimeRobot is primary) ---
SELF_PING_ENABLED=false
SELF_PING_URL=

# --- Dashboard session signing secret ---
# Used to sign login session cookies. If left blank, a random secret is
# generated at boot (which invalidates sessions on every restart). Set a long
# random value in production for stable sessions.
SESSION_SECRET=
