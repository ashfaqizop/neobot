{
  "name": "neobot",
  "version": "0.1.0",
  "description": "A Mineflayer-based anti-AFK bot that keeps a Minecraft server alive, deployed as a self-hostable, open-source, one-click template.",
  "type": "module",
  "license": "MIT",
  "author": "ashfaqizop <ashfaqizop@gmail.com>",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.2",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "anti-afk",
    "bot",
    "keep-alive",
    "self-hostable"
  ],
  "dependencies": {
    "express": "^4.22.2",
    "mineflayer": "^4.37.1",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.0",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.0.0"
  }
}
