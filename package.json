{
  "name": "neobot",
  "version": "1.0.1",
  "description": "A Mineflayer-based anti-AFK bot that keeps a Minecraft server alive, deployed as a self-hostable, open-source, one-click template.",
  "type": "module",
  "license": "MIT",
  "author": "ashfaqizop <ashfaqizop@gmail.com>",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.2",
  "main": "dist/index.js",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm run dev --workspace web",
    "build": "tsc -p tsconfig.build.json && npm run build --workspace web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "npm run build --workspace web",
    "start": "node dist/index.js",
    "test": "vitest run && npm run test --workspace web",
    "test:server": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run -c vitest.live.config.ts",
    "test:e2e": "playwright test",
    "e2e:serve": "npm run build:web && tsx src/index.ts",
    "lint": "eslint . && npm run lint --workspace web",
    "lint:fix": "eslint . --fix && npm run lint:fix --workspace web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "anti-afk",
    "bot",
    "keep-alive",
    "self-hostable"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "bcryptjs": "^3.0.3",
    "discord.js": "^14.27.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mineflayer": "^4.38.0",
    "mineflayer-pathfinder": "^2.4.5",
    "pino": "^10.3.1",
    "socket.io": "^4.8.3",
    "vec3": "^0.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.0",
    "eslint": "^9.17.0",
    "flying-squid": "^1.12.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.0.0"
  }
}
